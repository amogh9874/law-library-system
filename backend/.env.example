# PostgreSQL connection string (Supabase or any Postgres instance)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/law_library?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="8h"

# Server
PORT=4000
NODE_ENV="development"

# CORS - comma separated list of allowed origins
CORS_ORIGIN="http://localhost:5173"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# File uploads (book cover images)
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=5

# Default seeded accounts (used only by prisma/seed.ts)
SEED_OWNER_EMAIL="owner@lawfirm.com"
SEED_OWNER_PASSWORD="ChangeMe123!"
SEED_ADMIN_EMAIL="admin@lawfirm.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
